$(phplibdir)/apcu.la: ./apcu.la
	$(LIBTOOL) --tag=CC --mode=install cp ./apcu.la $(phplibdir)

./apcu.la: $(shared_objects_apcu) $(APCU_SHARED_DEPENDENCIES)
	$(LIBTOOL) --tag=CC --mode=link $(CC) -shared $(COMMON_FLAGS) $(CFLAGS_CLEAN) $(EXTRA_CFLAGS) $(LDFLAGS)  -o $@ -export-dynamic -avoid-version -prefer-pic -module -rpath $(phplibdir) $(EXTRA_LDFLAGS) $(shared_objects_apcu) $(APCU_SHARED_LIBADD)

