#!/usr/bin/env bash
set -euo pipefail

if [[ "$1" == "configure" ]]; then
    if [[ ! -f /usr/local/php-zts/lib/libphp.so ]]; then
        echo "WARNING: /usr/local/php-zts/lib/libphp.so not found." >&2
        echo "mod_apex requires a compatible PHP ZTS embed build at this path." >&2
    fi

    if command -v a2enmod >/dev/null 2>&1; then
        a2enmod headers apex >/dev/null || true
    fi
    if command -v a2enconf >/dev/null 2>&1; then
        a2enconf php-apex-security >/dev/null || true
    fi
    if [[ -x /usr/local/sbin/php-apex-mode ]] \
        && apachectl -M 2>/dev/null | grep -q 'mpm_event_module'; then
        if ! /usr/local/sbin/php-apex-mode auto; then
            echo "WARNING: run 'sudo php-apex-mode auto' after Apache is available." >&2
        fi
    else
        echo "PHP Apex: enable mpm_event, then run 'sudo php-apex-mode auto'." >&2
    fi
fi

exit 0
