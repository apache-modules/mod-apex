#!/usr/bin/env bash
set -euo pipefail

if [[ "$1" == "configure" ]]; then
    if [[ ! -f /usr/local/php-zts/lib/libphp.so ]]; then
        echo "WARNING: /usr/local/php-zts/lib/libphp.so not found." >&2
        echo "mod_apex requires a compatible PHP ZTS embed build at this path." >&2
    fi

    if command -v a2enmod >/dev/null 2>&1; then
        a2enmod apex >/dev/null || true
    fi
    if command -v a2enconf >/dev/null 2>&1; then
        a2enconf php-apex-performance >/dev/null || true
    fi

    if command -v apachectl >/dev/null 2>&1; then
        apachectl -t || true
    fi

    if command -v systemctl >/dev/null 2>&1; then
        systemctl reload apache2 >/dev/null 2>&1 || true
    fi
fi

exit 0
