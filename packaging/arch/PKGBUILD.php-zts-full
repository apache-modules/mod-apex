# Official Arch package recipe for the PHP ZTS runtime used by PHP Apex.
pkgname=php-zts-full
pkgver=8.4.21
pkgrel=1
pkgdesc='PHP ZTS embed runtime with OPcache, JIT, and common web extensions for PHP Apex'
arch=('x86_64')
url='https://github.com/apache-modules/mod-apex'
license=('PHP-3.01')
# PHP's ZTS VM uses GCC global register variables. Arch's default LTO cannot
# compile that code reliably; Fedora's php package makes the same exception.
options=('!lto')
depends=('curl' 'freetype2' 'gmp' 'icu' 'imagemagick' 'libjpeg-turbo'
         'libpng' 'libsodium' 'libwebp' 'libxml2' 'libxslt' 'libzip'
         'oniguruma' 'openssl' 'sqlite' 'zlib')
makedepends=('apache' 'autoconf' 'automake' 'base-devel' 'ca-certificates'
             'curl' 'freetype2' 'gmp' 'icu' 'imagemagick' 'libjpeg-turbo'
             'libpng' 'libsodium' 'libtool' 'libwebp' 'libxml2' 'libxslt'
             'libzip' 'oniguruma' 'openssl' 'pkgconf' 'sqlite' 'zlib')
source=("${pkgname}-${pkgver}.tar.gz" 'PHP-3.01.txt')
sha256sums=('SKIP' 'SKIP')

build() {
    cd "${srcdir}/${pkgname}-${pkgver}"
    PREFIX=/usr/local/php-zts \
    PACKAGE_BUILD_ROOT="${srcdir}/package-root" \
    SRC_DIR="${srcdir}/sources" \
    JOBS="$(nproc)" \
        ./packaging/build-php-zts.sh
}

package() {
    install -d "${pkgdir}/usr/local/php-zts"
    cp -a "${srcdir}/package-root/usr/local/php-zts/." \
        "${pkgdir}/usr/local/php-zts/"
    install -D -m 0644 "${srcdir}/PHP-3.01.txt" \
        "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
